# --- Required for the AI analyst -------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ — the key must not reach the browser.
ANTHROPIC_API_KEY=

# --- Optional ----------------------------------------------------------------
# Claude model used by /api/chat (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max (default: medium).
# ANTHROPIC_EFFORT=medium

# Per-IP request limits for /api/chat (each agent step is one request).
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_PER_DAY=400

# DEV ONLY: replay a scripted tool-use conversation instead of calling Claude.
# Ignored when NODE_ENV=production (next build / next start / Vercel).
# QUERYMIND_MOCK=1
